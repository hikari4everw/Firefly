---
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { profileConfig } from "@/config/profileConfig";
import UiIcon from "@/components/common/UiIcon.astro";
import UiText from "@/components/common/UiText.astro";
import { getUiContent } from "@/utils/ui-visibility";
import { getUiLinkAttributes } from "@/utils/ui-link-attributes";
import { url } from "@/utils/url-utils";

interface Props {
	uiTarget?: string;
	class?: string;
	style?: string;
}
const { style, uiTarget = "" } = Astro.props;
const className = Astro.props.class;
---

<div class:list={["card-base", "p-3", className]} style={style}>
  <a
    aria-label="Go to About Page"
    href={url("/about/")}
    class="group block relative mx-auto mt-1 lg:mx-0 lg:mt-0 mb-3
       max-w-48 lg:max-w-none overflow-hidden rounded-xl active:scale-95"
  >
    <div
      class="absolute transition pointer-events-none group-hover:bg-black/30 group-active:bg-black/50
        w-full h-full z-50 flex items-center justify-center"
    >
      <Icon
        name="fa7-regular:address-card"
        class="transition opacity-0 scale-90 group-hover:scale-100 group-hover:opacity-100 text-white text-5xl"
      />
    </div>
    <ImageWrapper
      src={profileConfig.avatar || ""}
      alt="Profile Image of the Author"
      class="profile-avatar-image mx-auto lg:w-full h-full lg:mt-0"
      loading="eager"
      fetchpriority="high"
      widths={[350]}
      sizes="350px"
    />
  </a>
  <div class="px-2">
    <div
      class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition"
    >
      <UiText target={uiTarget} field="name" value={profileConfig.name} />
    </div>
    <div
      class="h-1 w-5 bg-(--primary) mx-auto rounded-full mb-2 transition"
    >
    </div>
    <div class="text-center text-neutral-400 mb-2.5 transition">
      <UiText target={uiTarget} field="bio" value={profileConfig.bio} />
    </div>
        <div class="flex flex-wrap gap-2 justify-center mb-1">
            {profileConfig.links.map((item, index) => {
                const prefix = `link${index}`;
                const baseShowName = profileConfig.links.length === 1 || (item.showName ?? false);
                const showName = getUiContent(uiTarget, `${prefix}ShowName`, baseShowName);
                const linkClass = showName
                    ? "btn-regular rounded-lg h-10 gap-2 px-3 font-bold active:scale-95"
                    : "btn-regular rounded-lg h-10 w-10 active:scale-90";
                return <a {...getUiLinkAttributes(uiTarget, item.url, item.name, `${prefix}Url`, `${prefix}Name`, item.url.startsWith("http"), "me")} class={linkClass}>
                    <UiIcon target={uiTarget} field={`${prefix}Icon`} value={item.icon} class="text-[1.5rem]" />
                    <UiText target={uiTarget} field={`${prefix}Name`} value={item.name} showNameField={`${prefix}ShowName`} showName={baseShowName} />
                </a>;
            })}
        </div>
  </div>
</div>
