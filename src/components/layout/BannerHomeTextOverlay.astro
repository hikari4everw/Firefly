---
import UiIcon from "@/components/common/UiIcon.astro";
import UiText from "@/components/common/UiText.astro";
import TypewriterText from "@/components/features/TypewriterText.astro";
import { backgroundWallpaper, displaySettingsConfig } from "@/config";
import { getUiLinkAttributes } from "@/utils/ui-link-attributes";
import { resolveDisplaySettings } from "@/utils/saved-display-settings";
import { getUiContent, getHomeLinkVisibilityId } from "@/utils/ui-visibility";

interface Props {
	showHomeText: boolean;
	initialRandomSubtitle: string | undefined;
}

const { showHomeText, initialRandomSubtitle } = Astro.props;
const homeText = backgroundWallpaper.common?.homeText;
const originalSubtitles = homeText?.subtitle ?? [];
const subtitles = getUiContent("home-subtitle", "subtitles", Array.isArray(originalSubtitles) ? originalSubtitles : [originalSubtitles]);
const homeTextLinks = homeText?.links;
const homeTextLinksEnable = homeText?.linksEnable !== false;
const shouldRenderHomeText = homeText && (
	displaySettingsConfig.bannerTitleSwitchable || resolveDisplaySettings().bannerTitleEnabled
);
---
{shouldRenderHomeText && (
    <div class={`banner-home-text-overlay absolute inset-0 z-20 flex items-center justify-center ${!showHomeText ? 'hidden' : ''}`}>
        <div class="w-4/5 lg:w-3/4 text-center mb-0">
            <div class="flex flex-col">
                {homeText.title && (
                    <div class="banner-title font-bold text-white mb-2 lg:mb-4 leading-tight" data-ui-target="home-title" style={{ '--banner-title-size': homeText.titleSize || "3rem" }}>
                        <UiText target="home-title" field="text" value={homeText.title} />
                    </div>
                )}
                {homeText.subtitle && (
                    <div id="banner-subtitle" class="banner-subtitle text-white/90 leading-snug" style={{ fontSize: homeText.subtitleSize || "1.5rem" }} data-ui-target="home-subtitle" data-subtitles={JSON.stringify(subtitles)}>
                        {homeText.typewriter?.enable ? (
                            <TypewriterText
                                text={subtitles}
                                speed={homeText.typewriter.speed}
                                deleteSpeed={homeText.typewriter.deleteSpeed}
                                pauseTime={homeText.typewriter.pauseTime}
                            />
                        ) : (
                            <span data-ui-field="subtitles">{subtitles.includes(initialRandomSubtitle || "") ? initialRandomSubtitle : subtitles[0]}</span>
                        )}
                    </div>
                )}
                {/* 横幅标题下方的链接图标（subtitle 的兄弟节点，避免被打字机/随机副标题的 textContent 覆盖清掉） */}
                {homeTextLinksEnable && homeTextLinks && homeTextLinks.length > 0 && (
                    <div class="banner-links mt-5 flex items-center justify-center gap-3 pointer-events-auto">
                        {homeTextLinks.map((link) => {
                            const id = getHomeLinkVisibilityId(link.name);
                            const showName = getUiContent(id, "showName", link.showName ?? false);
                            return (
                                <a
                                    {...getUiLinkAttributes(id, link.url, link.name)}
                                    data-ui-target={id}
                                    class={showName ? "banner-link banner-link-text" : "banner-link"}
                                    style="color: #fff"
                                >
                                    <UiIcon target={id} value={link.icon} class="text-[1.25rem]" style="fill: currentColor" />
                                    <UiText target={id} field="name" value={link.name} showNameField="showName" showName={link.showName ?? false} />
                                </a>
                            );
                        })}
                    </div>
                )}
            </div>
        </div>
    </div>
)}

<script is:inline>
    function setRandomSubtitle() {
        const subtitleElement = document.getElementById('banner-subtitle');
        if (!subtitleElement) return;

        const subtitlesData = subtitleElement.dataset.subtitles;
        if (!subtitlesData) return;

        try {
            const subtitles = JSON.parse(subtitlesData);
            // Only randomize if it's an array and typewriter is NOT enabled (check for typewriter class)
            if (Array.isArray(subtitles) && subtitles.length > 0 && !subtitleElement.querySelector('.typewriter')) {
                // Use a global variable to persist the subtitle across Swup navigations
                // This variable will be reset on full page reload (F5), meeting the requirement
                if (!subtitles.includes(window.fireflyCachedSubtitle)) {
                    const randomIndex = Math.floor(Math.random() * subtitles.length);
                    window.fireflyCachedSubtitle = subtitles[randomIndex];
                }
                const text = subtitleElement.querySelector('[data-ui-field="subtitles"]');
                if (text) text.textContent = window.fireflyCachedSubtitle;
            }
        } catch (e) {
            console.error("Failed to parse subtitles", e);
        }
    }

    // Run on initial load
    setRandomSubtitle();
</script>
