---
import { resolveDisplaySettings } from "@/utils/saved-display-settings";

// 默认值走统一解析层（覆盖层 → 出厂值），保证服务端渲染与客户端读取一致
const displaySettings = resolveDisplaySettings();
---

<!-- 全局配置载体 -->
<div
  id="config-carrier"
  data-hue={displaySettings.hue}
  data-wallpaper-mode={displaySettings.wallpaperMode}
>
</div>
